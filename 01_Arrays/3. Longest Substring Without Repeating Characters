class Solution(object):
    def lengthOfLongestSubstring(self, s):
        i = 0
        lon_str = 0
        seen = set()

        for j in range(len(s)):
            while s[j] in seen :
                seen.remove(s[i])
                i+=1
            seen.add(s[j])  
            lon_str = max(lon_str , j - i +1)  
        return lon_str    


        